{
  "name": "courierofhearts",
  "private": true,
  "version": "3.0.0",
  "description": "CourierOfHearts v3 — write a letter worth keeping.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "build:pages": "VITE_DEMO_MODE=true vite build --base=/CourierOfHearts/ && cp dist/letter.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/api.test.mjs tests/crypto.test.mjs",
    "test:e2e": "playwright test",
    "backup": "node server/tools/backup.mjs",
    "restore": "node server/tools/restore.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource/almendra": "^5.2.8",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/crimson-pro": "^5.2.8",
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/great-vibes": "^5.2.8",
    "@fontsource/hind-siliguri": "^5.2.7",
    "@fontsource/marck-script": "^5.2.8",
    "@fontsource/medievalsharp": "^5.2.8",
    "@fontsource/noto-serif-bengali": "^5.2.10",
    "@fontsource/parisienne": "^5.2.8",
    "@fontsource/satisfy": "^5.2.7",
    "@fontsource/uncial-antiqua": "^5.2.7",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
