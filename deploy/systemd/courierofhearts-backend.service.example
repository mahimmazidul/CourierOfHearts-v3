# Generated by setup.sh — reference copy. $VARS are filled in at install time.
[Unit]
Description=CourierOfHearts v3 backend
After=network.target

[Service]
Type=simple
User=<current-user>
EnvironmentFile=<deploy-root>/config/courierofhearts.env
WorkingDirectory=<deploy-root>/app
ExecStart=/usr/bin/node <deploy-root>/app/server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=<deploy-root>/runtime <deploy-root>/backups

[Install]
WantedBy=multi-user.target
