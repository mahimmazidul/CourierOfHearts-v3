# CourierOfHearts v3 — environment configuration example.
# Copy to ~/courierofhearts/config/courierofhearts.env in production
# (setup.sh does this for you) or to .env for local experimentation.
# NEVER commit a file containing real secrets.

NODE_ENV=production

# Public domain the site is served from (nginx virtual host name).
PUBLIC_DOMAIN=domain.com

# Backend (Fastify) — MUST stay on 127.0.0.1 in production; nginx is the only
# public-facing service. xxx1 is a placeholder port, pick a free local port.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3947

# Frontend: production serves the built static files directly through nginx,
# so no frontend process/port is used. FRONTEND_PORT is only read by the dev
# tooling. If you ever do run a frontend process, keep it on 127.0.0.1.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3948

# Absolute path to the SQLite database. The application resolves a leading ~
# itself; systemd does not expand it for you.
DATABASE_PATH=~/courierofhearts/runtime/database/courierofhearts.db

# 64 hex chars (32 bytes). Wraps data-encryption keys for letters that have no
# password. Generate with: openssl rand -hex 32
# Production REFUSES to start with this placeholder value.
SERVER_KEK=change-me-openssl-rand-hex-32

# Secret for letter-management tokens (author edit/delete links).
JWT_SECRET=change-me-openssl-rand-hex-32

# Telegram (backend only — never exposed to the frontend bundle).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backups: 64 hex chars (32 bytes). Encrypts SQLite backups before they are
# stored/sent to Telegram. Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=~/courierofhearts/backups
BACKUP_RETENTION_DAYS=14

# Maximum flowers per letter (decoration cap, not an animation cap).
MAX_FLOWERS=300
